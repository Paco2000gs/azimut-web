{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "azimutproperty.com" }],
      "destination": "https://www.azimutproperty.com/:path",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/blog/1",
      "destination": "/blog/inmobiliaria-azimut-en-andalucia-cadiz-malaga-y-sevilla-1",
      "permanent": true
    },
    {
      "source": "/blog/2",
      "destination": "/blog/a-hidden-gem-on-the-border-exclusivity-on-the-shores-of-the-alqueva-reservoir-2",
      "permanent": true
    },
    {
      "source": "/blog/3",
      "destination": "/blog/ronda-where-time-stands-still-and-the-soul-finds-soaring-heights-3",
      "permanent": true
    },
    {
      "source": "/blog/4",
      "destination": "/blog/the-strategic-value-of-the-campo-de-gibraltar-for-international-land-investment-4",
      "permanent": true
    },
    {
      "source": "/blog/5",
      "destination": "/blog/majestic-manor-houses-in-estepa-luxury-history-and-exclusivity-in-the-heart-of-andalucia-5",
      "permanent": true
    },
    {
      "source": "/blog/6",
      "destination": "/blog/the-new-luxury-map-5-realities-transforming-the-real-estate-market-in-southern-spain-2025-2026-6",
      "permanent": true
    },
    {
      "source": "/blog/7",
      "destination": "/blog/introduction-to-real-estate-marbella-sotogrande-house-land-andalusian-state-equestrian-estate-olive-grove-7",
      "permanent": true
    },
    {
      "source": "/property/finca-jimena-de-la-frontera-19",
      "destination": "/properties/equestrian-estate-vineyard-sotogrande-cadiz-48-hectares",
      "permanent": true
    },
    {
      "source": "/property/villa-sotogrande-22",
      "destination": "/properties/villa-sotogrande-alto-golf-lake-views-spa",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
