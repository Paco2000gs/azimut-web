# Copy to .env (local) or set in Vercel → Settings → Environment Variables.
# Never commit real values: the repository is public.

# --- Public (bundled into the browser build; VITE_ prefix) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Footer social links. Leave empty to hide the icon.
VITE_SOCIAL_LINKEDIN_URL=
VITE_SOCIAL_FACEBOOK_URL=
VITE_SOCIAL_INSTAGRAM_URL=
VITE_SOCIAL_YOUTUBE_URL=

# --- Server only (Vercel Functions). NEVER prefix these with VITE_ ---
# Anything other than the literal "false" keeps the system in dry-run.
SOCIAL_DRY_RUN=true
SITE_URL=https://www.azimutproperty.com
# Comma-separated emails allowed to use /api/social
ADMIN_EMAILS=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SOCIAL_TOKEN_ENC_KEY=
OAUTH_STATE_SECRET=
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to the daily cron
CRON_SECRET=
VERCEL_DEPLOY_HOOK_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Video/image worker (GitHub Actions)
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=Paco2000gs/azimut-web
GITHUB_WORKFLOW=social-media.yml
GITHUB_REF=main
VIDEO_WORKER_SECRET=

# Meta (Facebook Page + Instagram Business)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
# Optional: pick this Page if your user manages more than one
META_PAGE_ID=

# LinkedIn (Community Management API)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202610
LINKEDIN_ORGANIZATION_ID=

# Google / YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_PRIVACY=public
